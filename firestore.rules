rules_version = '2';

// ⚠️ 重要：這個 app 用自訂的 localStorage／sessionStorage 登入（見 src/contexts/AuthContext.tsx），
// 並「沒有」使用 Firebase Authentication。因此規則裡 request.auth 永遠是 null——
// 任何依賴 request.auth 的規則都會讓整個 app（和遊戲）完全無法讀寫。
//
// ── 這一版做了什麼（2026-07-27）────────────────────────────────────────
// 在沒有身分驗證可用的前提下，先收斂「破壞面」：
//   1) 全面禁止 delete，只保留 app 真的會用到的四個 collection
//      （classrooms / conversations / pvpRooms / worksheets）。
//      已確認 src 與 public 全樹只有這四處刪除操作，學生資料從來不刪。
//      → 任何人都無法再抹掉學生的帳號、金幣、學習單進度、繪本作品。
//   2) auditLog 改成 append-only（可新增可讀，不可改不可刪）。
//      已確認程式只在交易裡 set 新文件，從不更新。
//      → 老師的金幣加扣紀錄變成不可竄改。
//   3) 其餘未列出的路徑一律預設拒絕（維持原本行為）。
//
// ── 這一版「沒有」解決什麼（重要，不要誤以為安全了）──────────────────
//   • 讀取仍然全開：任何人拿著前端 bundle 裡的公開 Firebase 設定，
//     不需登入就能讀出全部學生姓名與作品。這無法只靠規則解決，因為
//     規則沒有身分可以判斷。要擋「非本站流量」必須開 Firebase App Check。
//   • 寫入仍然全開：可以竄改他人資料（但不能刪除了）。
//     要做到「只能改自己的」必須先導入真正的 Firebase Auth
//     （例如後端用 Admin SDK 簽 custom token，登入時換取）。
// 下一步順序建議：App Check（擋非本站流量）→ Firebase Auth（per-user 規則）。

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 學生資料：可讀可寫，禁止刪除 ──────────────────────────────
    // 使用者資料 + 其下子集合（progress/quests、progress/lessons、picturebook、activities…）
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if false;
      match /{sub=**} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }

    // 學生學習單進度 + worksheets 子集合
    match /studentProgress/{studentId} {
      allow read, create, update: if true;
      allow delete: if false;
      match /{sub=**} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }

    match /memories/{id}        { allow read, create, update: if true; allow delete: if false; }
    match /coins/{id}           { allow read, create, update: if true; allow delete: if false; }   // 金幣餘額（app / 學習單 / 遊戲共用）
    match /battleStats/{id}     { allow read, create, update: if true; allow delete: if false; }
    match /cardCollections/{id} { allow read, create, update: if true; allow delete: if false; }
    match /gameProgress/{id}    { allow read, create, update: if true; allow delete: if false; }   // 單檔遊戲進度

    // ── 設定與素材：可讀可寫，禁止刪除 ────────────────────────────
    match /system/{id}          { allow read, create, update: if true; allow delete: if false; }   // featureFlags / announcement / cardImages / questImages
    match /settings/{id}        { allow read, create, update: if true; allow delete: if false; }   // activity
    match /themes/{id}          { allow read, create, update: if true; allow delete: if false; }
    match /cardAnimations/{id}  { allow read, create, update: if true; allow delete: if false; }

    // ── 稽核紀錄：只能新增（append-only），不可竄改 ────────────────
    match /auditLog/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ── app 真的會刪除的四個 collection，維持完整權限 ──────────────
    match /classrooms/{id}    { allow read, write: if true; }   // deleteClassroom
    match /conversations/{id} { allow read, write: if true; }   // deleteConversationDoc（學生刪自己的對話）
    match /pvpRooms/{id}      { allow read, write: if true; }   // deletePvpRoom
    match /worksheets/{id}    { allow read, write: if true; }   // deleteWorksheet

    // 其餘未列出的路徑：預設拒絕（Firestore 沒有匹配規則即拒絕）
  }
}
